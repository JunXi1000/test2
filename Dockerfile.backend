# ============================================================
# 会议白板助手 - 后端镜像 (Spring Boot 3.2 / Java 17 / Maven 内嵌)
# 多阶段构建: maven 构建 -> JRE 运行
# ============================================================

# ---------- 阶段 1: 构建 ----------
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build

# 使用阿里云镜像加速依赖下载(国内网络)
COPY docker/maven/settings.xml /root/.m2/settings.xml

# 先拷贝 pom.xml 单独拉取依赖，利用 Docker 层缓存
COPY pom.xml .
RUN mvn dependency:go-offline -B

# 再拷贝源码编译打包 (跳过测试,构建产物不含测试代码)
COPY src ./src
RUN mvn package -Dmaven.test.skip=true -B

# ---------- 阶段 2: 运行 ----------
FROM eclipse-temurin:17-jre
WORKDIR /app

# 时区设为上海
ENV TZ=Asia/Shanghai

# 从构建阶段拷贝产物 (finalName=template)
COPY --from=build /build/target/template.jar /app/template.jar

# 上传目录
RUN mkdir -p /app/uploads

# 默认端口
EXPOSE 1000

ENTRYPOINT ["java", "-jar", "/app/template.jar"]
