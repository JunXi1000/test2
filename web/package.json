    "lodash-es": "^4.17.23",
    "lucide-vue-next": "^0.575.0",
    "pinia": "^2.2.2",
    "tailwind-merge": "^3.5.0",
    "vue": "^3.4.29",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
